{
  "name": "vaultlink-backend",
  "version": "1.0.0",
  "description": "Backend server for VaultLink - a secure file and text sharing platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "kill-port": "lsof -ti:5000 | xargs kill -9 2>/dev/null || true",
    "dev:clean": "npm run kill-port && npm run dev"
  },
  "keywords": [
    "file-sharing",
    "text-sharing",
    "secure-links"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "firebase": "^12.9.0",
    "mongoose": "^9.1.6",
    "multer": "^2.0.2",
    "nanoid": "^5.0.4",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
